# ============ Nvidia AI Configuration ============
# NVIDIA_API_KEY: Required for Nvidia AI API calls
# Get from: https://www.nvidia.com/en-us/ai/ai-studio/
# Or https://api.nvcf.com for API access
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY_HERE"

# NVIDIA_MODEL: Model to use for AI tasks
# Examples: nvidia/llama-3.1-nemotron-70b-instruct, meta/llama-3.3-70b-instruct
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# ============ Frontend Configuration ============
# Local development can leave this empty because Vite proxies /api to the backend.
# In AWS Amplify, set this to your Render backend origin, for example:
# VITE_API_URL="https://resumatch-backend.onrender.com"
VITE_API_URL=""

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID for Google Sign-In
# Get from: https://console.cloud.google.com/
# 1. Create a new Web application OAuth 2.0 credential
# 2. Add authorized JavaScript origins:
#    - Local: http://localhost:5173
#    - Production: https://your-frontend-domain.com
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"

# APP_URL: Optional URL where this application is hosted
# Local development: http://localhost:5173
# Production: https://your-frontend-domain.com
APP_URL="http://localhost:5173"

# BACKEND_URL: Optional public backend origin in split deployments
# Production example: https://resumatch-xgok.onrender.com
BACKEND_URL=""

# JWT_SECRET: Secret key for JWT token signing
# Generate a secure random string (at least 32 characters)
JWT_SECRET="change-me-to-a-secure-random-key-min-32-chars"

# NEXTAUTH_SECRET: Secret for NextAuth.js (if using)
# Generate a secure random string (at least 32 characters)
NEXTAUTH_SECRET="change-me-to-a-secure-random-key-min-32-chars"

# BLOB_READ_WRITE_TOKEN: Vercel Blob API token for file storage
# Get from: https://vercel.com/account/storage/blob/manage
# Leave empty for local development (uses local uploads directory)
BLOB_READ_WRITE_TOKEN="YOUR_VERCEL_BLOB_TOKEN_HERE"

# ============ MongoDB Configuration (Optional) ============
# By default, the app uses SQLite. To use MongoDB instead, configure these:

# DB_TYPE: Choose between 'sqlite' (default) or 'mongodb'
DB_TYPE="sqlite"

# Render persistent-disk paths. Leave empty locally.
SQLITE_PATH=""
UPLOAD_DIR=""
MAX_UPLOAD_MB="10"

# MONGODB_URI: MongoDB connection string
# Leave empty to use SQLite only
# Local MongoDB: mongodb://localhost:27017/resumatch
# MongoDB Atlas (cloud): mongodb+srv://username:password@cluster.mongodb.net/resumatch?retryWrites=true&w=majority
# Get MongoDB Atlas connection string from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=""
