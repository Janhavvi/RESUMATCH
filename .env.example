# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID for Google Sign-In
# Get from: https://console.cloud.google.com/
# 1. Create a new Web application OAuth 2.0 credential
# 2. Add authorized redirect URIs:
#    - Local: http://localhost:3000/api/auth/callback/google
#    - Production: https://your-domain.vercel.app/api/auth/callback/google
# 3. Add authorized JavaScript origins:
#    - Local: http://localhost:3000
#    - Production: https://your-domain.vercel.app
GOOGLE_CLIENT_ID="YOUR_CLIENT_ID_HERE.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: OAuth 2.0 Client Secret for Google Sign-In
# Get from Google Cloud Console (same place as CLIENT_ID)
# IMPORTANT: Never commit this to version control!
GOOGLE_CLIENT_SECRET="YOUR_CLIENT_SECRET_HERE"

# APP_URL: The URL where this application is hosted
# Used for OAuth callbacks and self-referential links
# Local development: http://localhost:3000
# Production: https://your-domain.vercel.app
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for JWT token signing
# Generate a secure random string (at least 32 characters)
JWT_SECRET="change-me-to-a-secure-random-key-min-32-chars"

# NEXTAUTH_SECRET: Secret for NextAuth.js (if using)
# Generate a secure random string (at least 32 characters)
NEXTAUTH_SECRET="change-me-to-a-secure-random-key-min-32-chars"

# BLOB_READ_WRITE_TOKEN: Vercel Blob API token for file storage
# Get from: https://vercel.com/account/storage/blob/manage
# Leave empty for local development (uses local uploads directory)
BLOB_READ_WRITE_TOKEN="YOUR_VERCEL_BLOB_TOKEN_HERE"

